# Veritabanı
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/topluluk_db"

# JWT anahtarları — ikisi de FARKLI ve en az 32 karakter olmalı.
# Üretmek için: openssl rand -hex 32
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Sunucu
PORT=3000

# Tarayıcıdan istek atacak adresler (virgülle ayrılır)
CORS_ORIGINS="http://localhost:5500,http://127.0.0.1:5500"

# Şifre sıfırlama bağlantısının yönlendirileceği frontend adresi
FRONTEND_URL="http://localhost:5500"

# E-posta (SMTP). Boş bırakılırsa e-postalar gönderilmez, sadece loglanır.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
ADMIN_EMAIL=""

# İlk admin hesabı için (npm run seed)
ADMIN_PASSWORD=""
ADMIN_FULLNAME="HSD Yönetici"
